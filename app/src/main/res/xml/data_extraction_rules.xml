<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never upload app data to cloud backup. Direct phone-to-phone transfer is still allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
